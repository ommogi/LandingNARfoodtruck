# Copiar a .env y rellenar con credenciales reales. Nunca subir .env al repositorio.

# API key de Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Remitente verificado en Resend. Debe pertenecer a un dominio verificado.
LEAD_FROM_EMAIL=web@narfoodtruck.com

# Buzon comercial que recibe las solicitudes de presupuesto.
LEAD_TO_EMAIL=hola@narfoodtruck.com

# ID del contenedor de Google Tag Manager (https://tagmanager.google.com).
# El prefijo PUBLIC_ es obligatorio en Astro para que llegue al navegador: es un
# identificador publico, no un secreto.
#
# Dejalo vacio o sin definir en local y en previsualizaciones: sin el, la web no
# carga ningun script de analitica y no ensucia los datos de produccion.
# Configuracion de las etiquetas y eventos en docs/analitica.md.
PUBLIC_GTM_ID=GTM-XXXXXXX
