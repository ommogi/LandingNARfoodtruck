---
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/700.css';
import '@fontsource-variable/inter';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { site } from '../config/site';
import { CONSENT_STORAGE_KEY } from '../lib/consent';
import {
  breadcrumbNode,
  organizationNode,
  webPageNode,
  websiteNode,
  type BreadcrumbItem,
} from '../lib/schema';

interface Props {
  title: string;
  description: string;
  /** Ruta relativa para el canonical, por ejemplo "/" o "/privacidad". */
  path?: string;
  noindex?: boolean;
  /** Origen del lead que se envia a /api/presupuesto desde esta pagina. */
  leadSource?: string;
  /**
   * Nodos JSON-LD propios de la pagina (FAQPage, HowTo, Service...). Se anaden
   * al grafo comun de negocio + sitio + pagina que monta este layout.
   */
  schemas?: Record<string, unknown>[];
  /** Migas para el BreadcrumbList. "Inicio" se anade solo. */
  breadcrumbs?: BreadcrumbItem[];
  /** Texto alternativo de la imagen social. */
  ogImageAlt?: string;
}

const {
  title,
  description,
  path = '/',
  noindex = false,
  leadSource = 'landing-home',
  schemas = [],
  breadcrumbs = [],
  ogImageAlt = 'Food truck NAR iluminado y abierto durante un evento nocturno',
} = Astro.props;

const canonical = new URL(path, site.url).href;
const ogImage = new URL('/og-nar-foodtruck.jpg', site.url).href;

/**
 * ID publico del contenedor de Google Tag Manager. Sin el, no se emite ningun
 * script de analitica: en desarrollo y en previsualizaciones la web funciona
 * igual y no ensucia los datos de produccion.
 */
const gtmId = import.meta.env.PUBLIC_GTM_ID;

/* Un unico bloque JSON-LD por pagina: negocio + sitio + pagina, mas las migas
   y lo que aporte cada pagina. Los nodos se referencian por @id. */
const graph = [
  organizationNode(),
  websiteNode(),
  webPageNode({ title, description, canonical }),
  ...(breadcrumbs.length
    ? [breadcrumbNode([{ name: 'Inicio', path: '/' }, ...breadcrumbs], canonical)]
    : []),
  ...schemas,
];

const schema = { '@context': 'https://schema.org', '@graph': graph };
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {
      /*
       * Consent Mode v2. Tiene que ejecutarse SIEMPRE antes del snippet de GTM
       * y de forma sincrona: si GTM carga primero, GA4 escribe cookies antes de
       * que el usuario haya decidido nada. Por eso va `is:inline` y aqui
       * arriba, no en un modulo procesado por Astro.
       *
       * Arranca todo denegado y, si el navegador ya guardo una decision, la
       * aplica en el acto para que un visitante recurrente no pierda la
       * primera vista de pagina.
       */
      gtmId && (
        <script
          is:inline
          set:html={`
window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('consent', 'default', {
  ad_storage: 'denied',
  ad_user_data: 'denied',
  ad_personalization: 'denied',
  analytics_storage: 'denied',
  functionality_storage: 'denied',
  personalization_storage: 'denied',
  security_storage: 'granted',
  wait_for_update: 500
});
try {
  var stored = JSON.parse(localStorage.getItem(${JSON.stringify(CONSENT_STORAGE_KEY)}) || 'null');
  if (stored) {
    gtag('consent', 'update', {
      analytics_storage: stored.analytics ? 'granted' : 'denied',
      functionality_storage: stored.maps ? 'granted' : 'denied'
    });
  }
} catch (e) {
  /* localStorage bloqueado (modo privado, cookies de terceros): se queda en denegado. */
}
`}
        />
      )
    }

    {
      gtmId && (
        <script
          is:inline
          set:html={`
(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});
var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';
j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer',${JSON.stringify(gtmId)});
`}
        />
      )
    }
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#A63921" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-MNRN94QBRF"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-MNRN94QBRF');
    </script>

    {/* Cada pagina puede anadir aqui su propio schema o metadatos extra. */}
    <slot name="head" />
  </head>
  <body data-lead-source={leadSource}>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <slot name="overlays" />

    {/*
      Va en todas las paginas, tambien en las legales: el usuario tiene que
      poder decidir esté donde esté. Se renderiza aunque no haya GTM para que
      siga gobernando el mapa de Google, que es contenido de terceros.

      No se incluye el <noscript> de GTM a proposito: ese iframe dispara las
      etiquetas saltandose Consent Mode, y quien no tiene JavaScript tampoco
      puede consentir.
    */}
    <CookieBanner />

    {/*
      Va aqui y no en cada pagina: el banner lo pinta este layout, asi que su
      comportamiento le corresponde. Ademas garantiza que tambien funcione en
      las paginas legales, que no cargan `landing`.
    */}
    <script>
      import '../scripts/consent';
    </script>
  </body>
</html>
