---
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/700.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { site, mainNav, legalNav } from '../config/site';
import { CONSENT_STORAGE_KEY } from '../lib/consent';
import { breadcrumbNode, organizationNode, webPageNode, websiteNode } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  /** Ruta relativa para el canonical, por ejemplo "/" o "/privacidad". */
  path?: string;
  noindex?: boolean;
  /** Origen del lead que se envia a /api/presupuesto desde esta pagina. */
  leadSource?: string;
  /**
   * Nodos JSON-LD propios de la pagina (FAQPage, HowTo, Service...). Se anaden
   * al grafo comun de negocio + sitio + pagina que monta este layout.
   */
  schemas?: Record<string, unknown>[];
  /** Texto alternativo de la imagen social. */
  ogImageAlt?: string;
  /**
   * Sin cabecera ni pie de la web (el configurador trae su propia cabecera de
   * pasos). Mantiene fuentes, consentimiento, analitica y JSON-LD.
   */
  bare?: boolean;
}

const {
  title,
  description,
  path = '/',
  noindex = false,
  leadSource = 'landing-home',
  schemas = [],
  ogImageAlt = 'Food truck NAR iluminado y abierto durante un evento nocturno',
  bare = false,
} = Astro.props;

const canonical = new URL(path, site.url).href;
const ogImage = new URL('/og-nar-foodtruck.jpg', site.url).href;

/**
 * ID de medicion de Google Analytics 4 (G-XXXXXXXXXX). Sin el no se emite
 * nada de analitica: en desarrollo y en previsualizaciones la web funciona
 * igual y no ensucia los datos de produccion.
 *
 * Solo controla el bloque de Consent Mode. La carga de gtag.js la decide
 * src/scripts/consent.ts cuando el usuario acepta.
 */
const ga4Id = import.meta.env.PUBLIC_GA4_ID;

/* Un unico bloque JSON-LD por pagina: negocio + sitio + pagina, mas lo que
   aporte cada pagina. Los nodos se referencian por @id. */
const isHome = path === '/';
/* Nombre de la miga: la etiqueta del menu si la pagina esta en el, si no la
   primera parte del title ("Configura tu FOODD | NAR" -> "Configura tu FOODD"). */
const breadcrumbName =
  [...mainNav, ...legalNav].find((item) => item.href === path)?.label ?? title.split(' | ')[0];

const graph = [
  organizationNode(),
  websiteNode(),
  webPageNode({ title, description, canonical, hasBreadcrumb: !isHome }),
  ...(isHome ? [] : [breadcrumbNode(breadcrumbName, canonical)]),
  ...schemas,
];

const schema = { '@context': 'https://schema.org', '@graph': graph };
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {
      /*
       * Consent Mode v2. Va aqui arriba, `is:inline` y sincrono, para que el
       * estado por defecto quede fijado antes de que nada pueda medir.
       *
       * Arranca todo denegado. gtag.js NO se carga aqui: lo inyecta
       * src/scripts/consent.ts solo si el usuario acepta la analitica. Asi una
       * visita que rechaza no llega a pedir nada a Google.
       *
       * Si el navegador ya guardo una decision, se aplica en el acto para que
       * un visitante recurrente no pierda la primera vista de pagina.
       */
      ga4Id && (
        <script
          is:inline
          set:html={`
window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
window.gtag = gtag;
gtag('consent', 'default', {
  ad_storage: 'denied',
  ad_user_data: 'denied',
  ad_personalization: 'denied',
  analytics_storage: 'denied',
  functionality_storage: 'denied',
  personalization_storage: 'denied',
  security_storage: 'granted',
  wait_for_update: 500
});
try {
  var stored = JSON.parse(localStorage.getItem(${JSON.stringify(CONSENT_STORAGE_KEY)}) || 'null');
  if (stored) {
    gtag('consent', 'update', {
      analytics_storage: stored.analytics ? 'granted' : 'denied',
      functionality_storage: stored.maps ? 'granted' : 'denied'
    });
  }
} catch (e) {
  /* localStorage bloqueado (modo privado, cookies de terceros): se queda en denegado. */
}
`}
        />
      )
    }
    {/*
      Animaciones (src/scripts/animaciones.ts). `html.anim` oculta lo que GSAP
      va a hacer entrar, para que no se vea un parpadeo antes. Solo se pone
      con JS y sin movimiento reducido; si GSAP no arranca en 2,5 s se quita y
      todo queda visible. Sin JS, la clase nunca existe.
    */}
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('anim');
        setTimeout(function () {
          if (!document.documentElement.classList.contains('anim-lista')) {
            document.documentElement.classList.remove('anim');
          }
        }, 2500);
      }
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#A63921" />
    <link rel="canonical" href={canonical} />
    {/* Sello NAR completo, con transparencia salvo en iOS. */}
    <link rel="preload" href="/fonts/strawford/strawford-regular-webfont.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {/* `is:inline` explicito: no es un script que Astro deba procesar, es JSON. */}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />

    {/* Cada pagina puede anadir aqui su propio schema o metadatos extra. */}
    <slot name="head" />
  </head>
  <body data-lead-source={leadSource}>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    {!bare && <Header />}
    <main id="contenido">
      <slot />
    </main>
    {!bare && <Footer />}
    <slot name="overlays" />

    {/*
      Va en todas las paginas, tambien en las legales: el usuario tiene que
      poder decidir esté donde esté. Se renderiza aunque no haya analitica
      configurada, porque tambien gobierna el mapa de Google.
    */}
    <CookieBanner />

    {/*
      Va aqui y no en cada pagina: el banner lo pinta este layout, asi que su
      comportamiento le corresponde. Ademas garantiza que tambien funcione en
      las paginas legales, que no cargan `landing`.
    */}
    <script>
      import '../scripts/consent';
    </script>
  </body>
</html>
