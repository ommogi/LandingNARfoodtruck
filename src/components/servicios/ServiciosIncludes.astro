---
/**
 * Nuestros servicios. Ocho tarjetas sobre una rejilla de cuatro, maquetadas
 * con flex + basis en lugar de `grid`: si algun dia la ultima fila queda
 * incompleta, se centra sola sin reglas nth-child por breakpoint.
 */
import Icon from '../Icon.astro';
import SectionHeading from '../SectionHeading.astro';

const items = [
  {
    icon: 'truck',
    title: 'Alquiler del food truck',
    text: 'Food truck equipado y preparado para tu evento.',
  },
  {
    icon: 'sliders',
    title: 'Configuración a medida',
    text: 'Seleccionamos el equipamiento adecuado para cada tipo de servicio.',
  },
  {
    icon: 'pin',
    title: 'Logística y transporte',
    text: 'Coordinamos la entrega y recogida en la ubicación del evento.',
  },
  {
    icon: 'tools',
    title: 'Montaje y desmontaje',
    text: 'Nos encargamos de la instalación y posterior retirada.',
  },
  {
    icon: 'paintbrush',
    title: 'Personalización de marca',
    text: 'Vinilado y elementos gráficos adaptados a tu evento o identidad.',
  },
  {
    icon: 'sofa',
    title: 'Ambientación',
    text: 'Mobiliario, iluminación y decoración para completar el espacio.',
  },
  {
    icon: 'chef',
    title: 'Personal profesional',
    text: 'Cocinero disponible según las necesidades y disponibilidad del evento.',
  },
  {
    icon: 'headset',
    title: 'Asesoramiento y soporte',
    text: 'Te acompañamos desde la planificación hasta la celebración del evento.',
  },
] as const;

const card = [
  'basis-[calc(25%-15px)] rounded-card border border-line bg-white/70 px-5 py-[26px] text-center',
  'max-b900:basis-[calc(50%-10px)]',
  'max-b560:basis-full',
].join(' ');
---

<section class="section pt-0" aria-labelledby="servicios-includes-title">
  <div class="container">
    <SectionHeading id="servicios-includes-title" title="Nuestros servicios" />
    <p class="mx-auto -mt-6 mb-[34px] max-w-[620px] text-center text-[15px] text-muted">
      Todo lo necesario para que tu evento sea un éxito.
    </p>

    <ul
      class="m-0 flex list-none flex-wrap justify-center gap-5 p-0"
      data-reveal
      data-reveal-stagger
    >
      {
        items.map((item) => (
          <li class={card}>
            <Icon name={item.icon} size={38} class="mx-auto text-night" />
            <h3 class="mt-[15px] mb-2 text-[17px] font-bold tracking-[0.02em]">{item.title}</h3>
            <p class="m-0 text-[12.5px] leading-[1.5] text-muted">{item.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
