---
import Icon from '../Icon.astro';

/**
 * Cierre de /faq: cuatro razones para dar el paso, en la misma tira separada
 * por lineas que usan los heros de /el-truck y /galeria.
 */
const perks = [
  {
    icon: 'calendar',
    title: 'Fechas flexibles',
    text: 'Nos adaptamos a la fecha de tu evento.',
  },
  {
    icon: 'check',
    title: 'Atención personalizada',
    text: 'Te asesoramos para que el alquiler se ajuste a tus necesidades.',
  },
  {
    icon: 'euro',
    title: 'Precios transparentes',
    text: 'Presupuesto claro y sin costes ocultos.',
  },
  {
    icon: 'medal',
    title: 'Experiencia garantizada',
    text: 'Cada alquiler incluye montaje, soporte y recogida.',
  },
] as const;

const perk = [
  'grid grid-cols-[auto_1fr] items-start gap-x-3.5 gap-y-1 border-r border-line px-[22px]',
  'first:pl-0 last:border-r-0 last:pr-0',
  'max-b900:nth-[2n]:border-r-0 max-b900:nth-[2n]:pr-0 max-b900:nth-[2n+1]:pl-0',
  'max-b560:border-r-0 max-b560:px-0',
].join(' ');
---

<section class="section pt-0" aria-label="Por qué alquilar con NAR">
  <div class="container">
    <ul
      class="m-0 grid list-none grid-cols-4 p-0 max-b900:grid-cols-2 max-b900:gap-y-6 max-b560:grid-cols-1 max-b560:gap-y-5"
      data-reveal
    >
      {
        perks.map((item) => (
          <li class={perk}>
            <Icon name={item.icon} size={30} class="row-span-2 text-night" />
            <b class="font-display text-[15px] font-bold tracking-[0.03em] text-night uppercase">
              {item.title}
            </b>
            <small class="text-xs leading-[1.45] text-muted">{item.text}</small>
          </li>
        ))
      }
    </ul>
  </div>
</section>
