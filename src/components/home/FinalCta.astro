---
import Icon from '../Icon.astro';
---

<section id="presupuesto" class="section pt-0 print:hidden">
  <div class="container">
    <div
      class="grid grid-cols-[90px_1fr_auto] items-center gap-[26px] rounded-card bg-[linear-gradient(90deg,var(--color-rust-dark),var(--color-rust))] px-[46px] py-[30px] text-white max-b820:grid-cols-[70px_1fr] max-b820:p-[26px] max-b560:grid-cols-1 max-b560:text-center"
      data-reveal
    >
      <div class="grid place-items-center max-b560:justify-center" aria-hidden="true">
        <Icon name="calendar" size={58} />
      </div>

      <div>
        <h2 class="m-0 mb-1 text-[clamp(28px,3.2vw,38px)] leading-[1.05] font-bold">
          ¿Tienes una fecha en mente?
        </h2>
        <p class="m-0 max-w-[680px] text-[15px]">
          Cuéntanos tu evento y te enviaremos una propuesta personalizada sin compromiso en menos de
          24 horas.
        </p>
      </div>

      <button
        class="button button-light max-b820:col-span-full max-b820:w-full"
        type="button"
        data-form-open
        data-track="cta_final_click"
      >
        <Icon name="calendar" size={20} />
        Solicitar presupuesto
      </button>
    </div>
  </div>
</section>
