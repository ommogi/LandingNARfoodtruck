---
import Icon from '../Icon.astro';
import SectionHeading from '../SectionHeading.astro';
/* Los mismos pasos alimentan el schema HowTo de la home (src/lib/schema.ts). */
import { processSteps as steps } from '../../data/proceso';

/* El ::after es el conector punteado entre pasos, solo en escritorio. */
const step = [
  'relative p-2.5 text-center',
  "not-last:after:absolute not-last:after:top-[52px] not-last:after:left-[calc(50%+58px)] not-last:after:w-[calc(100%-116px)] not-last:after:border-t-2 not-last:after:border-dashed not-last:after:border-rust/35 not-last:after:content-['']",
  'max-b1100:after:hidden',
].join(' ');
---

<section class="section" aria-labelledby="process-title">
  <div class="container">
    <div class="max-b820:hidden">
      <SectionHeading id="process-title" title="Así trabajamos" />
    </div>

    {/*
      En movil los cinco pasos ocupaban demasiado: se pliegan tras este boton
      (src/scripts/landing.ts). En escritorio el boton no existe y la lista
      se ve siempre.
    */}
    <button
      type="button"
      class="hidden w-full items-center justify-between rounded-card border border-line bg-white px-5 py-4 font-display text-[22px] font-bold text-night uppercase shadow-card max-b820:flex"
      aria-expanded="false"
      aria-controls="process-pasos"
      data-plegable
    >
      Así trabajamos
      <Icon name="chevron" size={22} class="text-rust transition-transform" />
    </button>

    <ol
      id="process-pasos"
      class="m-0 grid list-none max-b820:mt-6 max-b820:[&:not(.is-abierto)]:hidden grid-cols-5 gap-[22px] p-0 max-b1100:grid-cols-3 max-b1100:gap-7 max-b820:grid-cols-2 max-b560:grid-cols-1 max-b560:gap-5"
    >
      {
        steps.map((step_, i) => (
          <li class={step} data-reveal>
            <div class="relative mx-auto mb-3.5 w-[92px]">
              <span class="absolute -top-1 -left-0.5 z-2 grid size-8 place-items-center rounded-full bg-rust font-display text-[17px] font-bold text-white">
                {i + 1}
              </span>
              <div class="grid size-[92px] place-items-center rounded-full bg-[#eee7e2] text-night">
                <Icon name={step_.icon} size={34} />
              </div>
            </div>
            <h3 class="m-0 mb-1.5 text-[19px] font-bold">{step_.title}</h3>
            <p class="m-0 text-[13px] leading-[1.5] text-muted">{step_.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
