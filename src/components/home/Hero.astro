---
import { Image } from 'astro:assets';
import hero from '../../assets/hero-home-atardecer.webp';
import Icon from '../Icon.astro';
import { site } from '../../config/site';

/* `corto` es la etiqueta de los chips del hero en movil. */
const points = [
  { title: 'Food truck premium', corto: 'Premium', text: 'Diseño profesional preparado para eventos.' },
  {
    title: 'Configuración a tu medida',
    corto: 'A tu medida',
    text: 'Elige equipamiento, ambientación y personalización.',
  },
  {
    title: `Cobertura en ${site.areaServedLong}`,
    corto: 'Toda España',
    text: 'Llevamos NAR hasta donde esté tu evento.',
  },
] as const;
---

{/* Unica seccion que no usa el degradado crema del body. */}
<section
  id="inicio"
  class="relative grid min-h-[640px] items-center overflow-hidden bg-[#080808] text-white max-b820:min-h-0 max-b820:items-end"
>
  {/* En movil: una sola pantalla. La foto llena la mitad de arriba (truck entero) y se funde con el fondo; el contenido compacto va abajo. */}
  <div class="absolute inset-0 overflow-hidden max-b820:bottom-auto max-b820:h-[min(92vw,460px)]" data-anim="hero-media">
    <Image
      src={hero}
      alt=""
      widths={[640, 960, 1280, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      aria-hidden="true"
      class="size-full object-cover object-center max-b820:object-[64%_center]"
    />
  </div>
  {/*
    Velo negro solo donde hace falta: denso bajo el texto y casi transparente
    a la derecha (en movil, arriba), para que la foto luzca y el titular se lea.
  */}
  <div
    class="absolute inset-0 bg-[linear-gradient(90deg,rgb(0_0_0_/_88%)_0%,rgb(0_0_0_/_70%)_45%,rgb(0_0_0_/_40%)_100%)] max-b820:bottom-auto max-b820:h-[min(92vw,460px)] max-b820:bg-[linear-gradient(180deg,transparent_0%,transparent_55%,rgb(8_8_8_/_70%)_80%,#080808_100%)]"
    aria-hidden="true"
  >
  </div>

  <div class="container relative z-2 pt-16 pb-[84px] max-b820:pt-[min(76vw,380px)] max-b820:pb-14">
    <div class="max-w-[630px]" data-anim="hero">
      <p class="eyebrow">Alquiler de food trucks para eventos</p>
      <h1
        class="m-0 text-[clamp(44px,5.2vw,76px)] leading-[0.91] font-bold tracking-[-0.02em] max-b820:text-[clamp(34px,9.4vw,44px)]"
      >
        Haz que tu evento sea imposible <em class="block text-rust not-italic">de olvidar.</em>
      </h1>
      <p class="my-[22px] max-w-[600px] text-lg text-white/90 max-b820:hidden">
        En {site.name} alquilamos food trucks premium totalmente equipados para bodas, empresas,
        ferias y eventos privados. Nosotros nos encargamos de todo para que tú solo disfrutes.
      </p>

      {/* En movil cada punto es un chip con la etiqueta corta, sin subtitulo. */}
      <ul
        class="mx-0 mt-7 mb-8 flex list-none gap-[30px] p-0 max-b820:mt-5 max-b820:mb-6 max-b820:flex-wrap max-b820:gap-2"
      >
        {
          points.map((point) => (
            <li class="max-w-[200px] text-[13px] leading-[1.35] max-b820:max-w-none max-b820:rounded-full max-b820:border max-b820:border-white/30 max-b820:bg-black/25 max-b820:px-3 max-b820:py-1.5 max-b820:backdrop-blur-sm">
              <strong class="block font-display text-[15px] font-bold tracking-[0.03em] uppercase max-b820:text-[12px]">
                <span class="text-rust" aria-hidden="true">+ </span>
                <span class="max-b820:hidden">{point.title}</span>
                <span class="hidden max-b820:inline">{point.corto}</span>
              </strong>
              <span class="mt-1 block text-white/80 max-b820:hidden">{point.text}</span>
            </li>
          ))
        }
      </ul>

      {/* En movil, una fila: CTA principal a todo el ancho y video como boton de icono. */}
      <div class="flex flex-wrap gap-3.5 max-b820:grid max-b820:grid-cols-[1fr_auto] max-b820:gap-2.5 print:hidden">
        <a
          class="button button-primary max-b820:w-full max-b820:px-3 max-b820:text-[16px]"
          href="/configurador"
          data-track="cta_hero_click"
        >
          <Icon name="calendar" size={20} />
          Configura tu food truck
        </a>
        <button
          class="button button-ghost max-b820:w-[50px] max-b820:px-0"
          type="button"
          data-video-open
          data-video="eventos"
          aria-label="Ver vídeo"
        >
          <Icon name="play" size={20} />
          <span class="max-b820:sr-only">Ver vídeo</span>
        </button>
      </div>
    </div>
  </div>
</section>
