---
import { Image } from 'astro:assets';
import hero from '../../assets/hero-home-atardecer.webp';
import Icon from '../Icon.astro';
import { site } from '../../config/site';

const points = [
  { title: 'Food truck premium', text: 'Diseño profesional preparado para eventos.' },
  {
    title: 'Configuración a tu medida',
    text: 'Elige equipamiento, ambientación y personalización.',
  },
  { title: `Cobertura en ${site.areaServedLong}`, text: 'Llevamos NAR hasta donde esté tu evento.' },
] as const;
---

{/* Unica seccion que no usa el degradado crema del body. */}
<section
  id="inicio"
  class="relative grid min-h-[640px] items-center overflow-hidden bg-[#080808] text-white max-b820:min-h-[660px]"
>
  <div class="absolute inset-0" data-anim="hero-media">
    <Image
      src={hero}
      alt=""
      widths={[640, 960, 1280, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      aria-hidden="true"
      class="size-full object-cover object-center max-b820:object-[62%_center]"
    />
  </div>
  {/*
    Velo negro solo donde hace falta: denso bajo el texto y casi transparente
    a la derecha, para que la foto del atardecer luzca y el titular se lea.
  */}
  <div
    class="absolute inset-0 bg-[linear-gradient(90deg,rgb(0_0_0_/_88%)_0%,rgb(0_0_0_/_70%)_45%,rgb(0_0_0_/_40%)_100%)] max-b820:bg-[rgb(0_0_0_/_72%)]"
    aria-hidden="true"
  >
  </div>

  <div class="container relative z-2 pt-16 pb-[84px] max-b560:pt-[46px] max-b560:pb-16">
    <div class="max-w-[630px]" data-anim="hero">
      <p class="eyebrow">Alquiler de food trucks para eventos</p>
      <h1
        class="m-0 text-[clamp(44px,5.2vw,76px)] leading-[0.91] font-bold tracking-[-0.02em] max-b820:text-[clamp(40px,10vw,64px)]"
      >
        Haz que tu evento sea imposible <em class="block text-rust not-italic">de olvidar.</em>
      </h1>
      <p class="my-[22px] max-w-[600px] text-lg text-white/90 max-b560:text-base">
        En {site.name} alquilamos food trucks premium totalmente equipados para bodas, empresas,
        ferias y eventos privados. Nosotros nos encargamos de todo para que tú solo disfrutes.
      </p>

      <ul
        class="mx-0 mt-7 mb-8 flex list-none gap-[30px] p-0 max-b820:grid max-b820:grid-cols-2 max-b820:gap-4 max-b560:grid-cols-1 max-b560:gap-3"
      >
        {
          points.map((point) => (
            <li class="max-w-[200px] text-[13px] leading-[1.35] max-b560:max-w-none">
              <strong class="block font-display text-[15px] font-bold tracking-[0.03em] uppercase">
                <span class="text-rust" aria-hidden="true">+ </span>
                {point.title}
              </strong>
              <span class="mt-1 block text-white/80">{point.text}</span>
            </li>
          ))
        }
      </ul>

      <div class="flex flex-wrap gap-3.5 max-b560:grid print:hidden">
        <a
          class="button button-primary max-b560:w-full"
          href="/configurador"
          data-track="cta_hero_click"
        >
          <Icon name="calendar" size={20} />
          Configura tu food truck
        </a>
        <button class="button button-ghost max-b560:w-full" type="button" data-video-open data-video="eventos">
          <Icon name="play" size={20} />
          Ver vídeo
        </button>
      </div>
    </div>
  </div>
</section>
