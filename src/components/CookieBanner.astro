---
/**
 * Banner de consentimiento de cookies. Sin librerias externas, como el resto
 * de la web.
 *
 * Dos piezas: el aviso inferior y un panel de ajuste por categorias. El
 * comportamiento vive en src/scripts/consent.ts; aqui solo esta el marcado.
 *
 * Ambos arrancan con `hidden`: el script decide si mostrarlos leyendo la
 * decision guardada. Asi quien ya respondio no vuelve a ver nada, y quien
 * tiene JavaScript desactivado no ve un banner que no podria usar.
 *
 * "Aceptar todo" y "Rechazar todo" son el mismo boton con distinto color y
 * estan al mismo nivel, a un solo clic. Es lo que exige la AEPD y es el error
 * que mas se sanciona: esconder el rechazo detras de "configurar".
 */
import Icon from './Icon.astro';
import { CONSENT_CATEGORIES } from '../lib/consent';

const card = 'rounded-card border border-line bg-white shadow-card';
/* Botones mas compactos que los de pagina: aqui compiten con el contenido. */
const compact = 'button min-h-[44px] px-5 text-[15px]';
---

<div
  class="fixed inset-x-0 bottom-0 z-[1200] p-4 print:hidden max-b560:p-3"
  hidden
  data-consent-banner
  role="region"
  aria-label="Aviso de cookies"
>
  <div class={`${card} mx-auto flex max-w-[1080px] items-center gap-6 p-5 max-b900:flex-col max-b900:items-start max-b900:gap-4`}>
    <div class="flex min-w-0 items-start gap-3.5">
      <span class="mt-0.5 grid size-9 flex-none place-items-center rounded-full bg-rust/10 text-rust">
        <Icon name="shield" size={20} />
      </span>
      <p class="m-0 text-sm text-muted">
        Usamos cookies propias necesarias para que la web funcione y, solo si nos das permiso, cookies
        de analítica para saber qué contenidos son útiles. También puedes decidir si cargamos el mapa
        de Google en la página de contacto. Más detalle en la <a
          class="text-rust underline underline-offset-2"
          href="/cookies">política de cookies</a
        >.
      </p>
    </div>

    <div class="flex flex-none flex-wrap items-center gap-2.5 max-b560:w-full">
      <button class={`${compact} button-line max-b560:flex-1`} type="button" data-consent-reject>
        Rechazar todo
      </button>
      <button class={`${compact} button-primary max-b560:flex-1`} type="button" data-consent-accept>
        Aceptar todo
      </button>
      <button
        class="min-h-[44px] cursor-pointer border-0 bg-transparent px-2 text-sm text-muted underline underline-offset-2 hover:text-night max-b560:w-full"
        type="button"
        data-consent-open
      >
        Configurar
      </button>
    </div>
  </div>
</div>

<div
  class="fixed inset-0 z-[1300] grid place-items-center p-5 print:hidden"
  hidden
  data-consent-modal
  role="dialog"
  aria-modal="true"
  aria-labelledby="consent-title"
>
  <div class="absolute inset-0 bg-black/60 backdrop-blur-[4px]" data-consent-close data-modal-backdrop>
  </div>

  <div
    class={`${card} relative z-1 w-[min(620px,100%)] max-h-[86vh] overflow-y-auto p-7 max-b560:p-5`}
    data-modal-panel
  >
    <div class="mb-5 flex items-start justify-between gap-4">
      <div>
        <h2 id="consent-title" class="m-0 text-[clamp(24px,3vw,30px)] leading-[1.05] font-bold text-night">
          Preferencias de cookies
        </h2>
        <p class="mt-2 mb-0 text-sm text-muted">
          Elige qué quieres permitir. Puedes cambiarlo cuando quieras desde la política de cookies.
        </p>
      </div>
      <button
        class="grid size-10 flex-none cursor-pointer place-items-center rounded-full border border-line bg-white text-ink"
        type="button"
        data-consent-close
        aria-label="Cerrar preferencias"
      >
        <Icon name="close" size={20} />
      </button>
    </div>

    <ul class="m-0 grid list-none gap-3 p-0">
      <li class="rounded-lg border border-line bg-bg-1 p-4">
        <div class="flex items-center justify-between gap-4">
          <h3 class="m-0 text-lg font-bold text-night">Técnicas</h3>
          <span class="text-xs font-semibold tracking-wide text-muted uppercase">Siempre activas</span>
        </div>
        <p class="mt-1.5 mb-0 text-sm text-muted">
          Imprescindibles para navegar y enviar el formulario. No se pueden desactivar y no sirven
          para seguirte.
        </p>
      </li>

      {
        CONSENT_CATEGORIES.map((category) => (
          <li class="rounded-lg border border-line bg-white p-4">
            <label class="flex cursor-pointer items-center justify-between gap-4">
              <h3 class="m-0 text-lg font-bold text-night">{category.label}</h3>
              <input
                class="size-5 flex-none accent-rust"
                type="checkbox"
                data-consent-toggle={category.id}
              />
            </label>
            <p class="mt-1.5 mb-0 text-sm text-muted">{category.description}</p>
          </li>
        ))
      }
    </ul>

    <div class="mt-6 flex flex-wrap gap-2.5 max-b560:grid">
      <button class={`${compact} button-primary`} type="button" data-consent-save>
        Guardar selección
      </button>
      <button class={`${compact} button-line`} type="button" data-consent-reject>
        Rechazar todo
      </button>
      <button class={`${compact} button-line`} type="button" data-consent-accept>
        Aceptar todo
      </button>
    </div>
  </div>
</div>
