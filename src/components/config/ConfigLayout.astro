---
/**
 * Fila de tres tarjetas: plano interior, para quien es cada configuracion y el
 * CTA de reserva. El plano tiene id propio porque el boton "Ver plano" de los
 * modales cierra el dialogo y trae al usuario hasta aqui.
 */
import Icon from '../Icon.astro';
import FloorPlan from './FloorPlan.astro';
import { idealPara } from '../../data/configuraciones';

const card =
  'rounded-card border border-[rgb(56_40_30_/_8%)] bg-white/96 px-[26px] pt-[26px] pb-[22px] shadow-card max-b560:px-[18px]';
const cardTitle = 'm-0 mb-2.5 text-[22px] leading-[1.1] font-bold text-blue';
---

<section class="section" aria-labelledby="distribucion-title">
  <div
    class="container grid grid-cols-[1.25fr_0.9fr_0.85fr] items-start gap-[18px] max-b1100:grid-cols-2 max-b820:grid-cols-1"
    data-reveal
  >
    <article class={card} id="distribucion-interior">
      <h2 id="distribucion-title" class={cardTitle}>Distribución interior</h2>
      <p class="mt-0 mb-5 text-[12.5px] leading-[1.5] text-muted">
        Conoce la distribución y medidas de nuestro food truck para planificar tu espacio de trabajo
        de manera eficiente.
      </p>
      <FloorPlan />
    </article>

    <article class={card}>
      <h2 class={cardTitle}>Ideal para</h2>
      <ul class="m-0 grid list-none gap-[18px] p-0">
        {
          idealPara.map((item) => (
            <li class="grid grid-cols-[42px_1fr] items-start gap-3.5">
              <Icon name={item.icon} size={34} class="text-night" />
              <div>
                <b class="block text-[13.5px] font-bold text-night">{item.title}</b>
                <small class="text-[12px] leading-[1.45] text-muted">{item.text}</small>
              </div>
            </li>
          ))
        }
      </ul>
    </article>

    <article class={card}>
      <h2 class={cardTitle}>¿Listo para reservar?</h2>
      <p class="mt-0 mb-5 text-[12.5px] leading-[1.5] text-muted">
        Consulta disponibilidad para tu fecha y asegura tu reserva.
      </p>
      <button
        class="button button-primary button-block"
        type="button"
        data-form-open
        data-track="cta_config_reservar"
      >
        <Icon name="calendar" size={20} />
        Reservar fecha
      </button>
    </article>
  </div>
</section>
