---
/**
 * Plano de la distribucion interior. Es SVG en linea y no una imagen porque el
 * plano lleva texto (zonas y cotas): asi se lee con lector de pantalla, escala
 * sin perder nitidez y se traduce sin reexportar nada.
 *
 * Medidas reales: 4,00 m de longitud interior por 2,20 m de ancho.
 */
const dim = 'fill-none stroke-night [stroke-width:1.4] [stroke-linecap:round]';
const dimLabel = 'font-body text-[15px] font-bold fill-night';
const shell = 'fill-none stroke-night [stroke-width:2.4]';
const unit = 'fill-white stroke-[#8d8d8d] [stroke-width:1.3]';
/* Colores de zona en tono muy bajo: el plano se lee, no decora. */
const zone = 'stroke-[rgb(10_28_38_/_22%)] [stroke-width:1]';
const zoneLabel =
  'font-display text-[15px] font-bold uppercase tracking-[0.02em] fill-night';
---

<svg class="block h-auto w-full" viewBox="0 0 760 372" role="img" aria-labelledby="plan-title plan-desc">
  <title id="plan-title">Plano de la distribución interior del food truck</title>
  <desc id="plan-desc">
    Espacio interior de 4,00 metros de largo por 2,20 metros de ancho, dividido en zona de
    preparación a la izquierda, zona de cocción en el centro y zona de servicio junto a la ventana.
  </desc>

  <!-- Cota superior: longitud interior -->
  <g class={dim}>
    <path d="M124 30v14M676 30v14M124 37h552"></path>
    <path d="m136 31-10 6 10 6M664 31l10 6-10 6" class="[stroke-linejoin:round]"></path>
  </g>
  <text class={dimLabel} x="400" y="22" text-anchor="middle">4,00 m</text>

  <!-- Cota lateral: ancho -->
  <g class={dim}>
    <path d="M52 76h14M52 336h14M59 76v260"></path>
    <path d="m53 88 6-10 6 10M53 324l6 10 6-10" class="[stroke-linejoin:round]"></path>
  </g>
  <text class={dimLabel} x="30" y="206" text-anchor="middle" transform="rotate(-90 30 206)"
    >2,20 m</text
  >

  <!-- Carroceria -->
  <rect class={shell} x="124" y="76" width="552" height="260" rx="72"></rect>
  <rect
    class="fill-white stroke-night [stroke-width:1.2]"
    x="138"
    y="90"
    width="524"
    height="232"
    rx="60"></rect>
  <!-- Lanza de enganche -->
  <path class={shell} d="M676 190h34"></path>

  <!-- Mobiliario del lateral superior -->
  <g class={unit}>
    <rect x="176" y="98" width="70" height="46" rx="4"></rect>
    <rect x="252" y="98" width="70" height="46" rx="4"></rect>
    <rect x="404" y="98" width="88" height="46" rx="4"></rect>
    <rect x="498" y="98" width="70" height="46" rx="4"></rect>
    <rect x="574" y="98" width="52" height="46" rx="4"></rect>
  </g>
  <!-- Plancha -->
  <g class="fill-[#e6e3e0] stroke-[#6f6f6f] [stroke-width:1.3]">
    <rect x="328" y="98" width="70" height="46" rx="4"></rect>
    <path d="M338 110h50M338 122h50M338 134h50"></path>
  </g>

  <!-- Mobiliario del lateral inferior -->
  <g class={unit}>
    <rect x="176" y="268" width="70" height="46" rx="4"></rect>
    <rect x="252" y="268" width="70" height="46" rx="4"></rect>
    <rect x="574" y="268" width="52" height="46" rx="4"></rect>
  </g>
  <!-- Freidoras dobles -->
  <g class={unit}>
    <rect x="404" y="266" width="120" height="50" rx="6"></rect>
    <circle cx="434" cy="291" r="17"></circle>
    <circle cx="494" cy="291" r="17"></circle>
  </g>

  <!-- Fuegos -->
  <g class={unit}>
    <rect x="330" y="154" width="66" height="66" rx="4"></rect>
    <circle cx="348" cy="172" r="8"></circle>
    <circle cx="378" cy="172" r="8"></circle>
    <circle cx="348" cy="202" r="8"></circle>
    <circle cx="378" cy="202" r="8"></circle>
  </g>

  <!-- Zonas de trabajo -->
  <rect
    class:list={[zone, 'fill-[rgb(3_76_140_/_22%)]']}
    x="176"
    y="154"
    width="140"
    height="100"
    rx="6"></rect>
  <text class={zoneLabel} x="246" y="197" text-anchor="middle">Zona de</text>
  <text class={zoneLabel} x="246" y="215" text-anchor="middle">preparación</text>

  <rect
    class:list={[zone, 'fill-[rgb(166_57_33_/_20%)]']}
    x="404"
    y="154"
    width="222"
    height="100"
    rx="6"></rect>
  <text class={zoneLabel} x="515" y="197" text-anchor="middle">Zona de</text>
  <text class={zoneLabel} x="515" y="215" text-anchor="middle">cocción</text>

  <rect
    class:list={[zone, 'fill-[rgb(214_168_42_/_30%)]']}
    x="534"
    y="262"
    width="120"
    height="58"
    rx="6"></rect>
  <text class={zoneLabel} x="594" y="286" text-anchor="middle">Zona de</text>
  <text class={zoneLabel} x="594" y="304" text-anchor="middle">servicio</text>
</svg>
