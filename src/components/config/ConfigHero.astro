---
/**
 * Hero de /configuraciones. Misma familia que el de /el-truck (ficha de
 * producto sobre el degradado crema), con el render de cotas a la derecha:
 * la imagen ya trae rotulados 2,40 m y 5,40 m, no se dibujan en CSS.
 */
import Icon from '../Icon.astro';
import TruckDimensions from './TruckDimensions.astro';
---

<section id="configuraciones" class="section pt-[34px]">
  <div class="container">
    <div
      class="grid grid-cols-[0.86fr_1.14fr] items-center gap-x-[46px] gap-y-[30px] max-b980:grid-cols-1"
    >
      <div data-reveal>
        <p class="eyebrow eyebrow-rust">
          Configuraciones
          <span class="ml-1 inline-block align-[1px]" aria-hidden="true">
            <Icon name="star" size={13} fill="currentColor" />
          </span>
        </p>

        <h1 class="m-0 text-[clamp(34px,4.2vw,56px)] leading-[0.96] font-bold text-night">
          Configura tu food truck
          <em class="block text-rust not-italic">a la medida</em>
          <em class="block text-rust not-italic">de tu proyecto.</em>
        </h1>

        <p class="mt-[22px] mb-[26px] max-w-[440px] text-[14.5px] text-muted">
          Elige el equipamiento, el servicio y la ambientación que necesitas paso a paso. Todas
          nuestras unidades incluyen instalación profesional y están listas para trabajar.
        </p>

        <a
          class="button button-primary max-b620:w-full print:hidden"
          href="/configurador"
          data-track="cta_config_hero"
        >
          Configura tu food truck
          <Icon name="arrow" size={20} />
        </a>
      </div>

      {/* Foto recortada sin fondo: las cotas y la sombra se dibujan en CSS. */}
      <TruckDimensions
        loading="eager"
        sizes="(max-width: 980px) 100vw, 56vw"
        class="max-b980:order-first"
        data-reveal
      />
    </div>
  </div>
</section>
