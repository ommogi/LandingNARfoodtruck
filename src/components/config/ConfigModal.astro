---
/**
 * Ficha completa de una configuracion. Se pinta un modal por configuracion,
 * oculto en carga; src/scripts/configuraciones.ts los abre por id reutilizando
 * openModal/closeModal de scripts/modal.ts (foco, Escape y focus trap).
 */
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import {
  idealPara,
  technicalSpecs,
  truckRender,
  type Configuration,
} from '../../data/configuraciones';

interface Props {
  config: Configuration;
}

const { config } = Astro.props;

/* El acento de la tarjeta se mantiene dentro del modal para que el usuario
   reconozca la configuracion que acaba de abrir. */
const accentText = {
  blue: 'text-blue',
  rust: 'text-rust',
  night: 'text-night',
}[config.accent];

const accentBg = {
  blue: 'bg-blue',
  rust: 'bg-rust',
  night: 'bg-night',
}[config.accent];

const blockTitle = 'm-0 mb-3.5 text-[17px] font-bold tracking-[0.02em] text-night';
---

<div
  class="fixed inset-0 z-[1000] grid place-items-center p-5 print:hidden max-b560:p-2.5"
  hidden
  data-config-modal={config.id}
  role="dialog"
  aria-modal="true"
  aria-labelledby={`config-${config.id}-title`}
>
  <div
    class="absolute inset-0 bg-black/76 backdrop-blur-[5px]"
    data-config-close
    data-modal-backdrop
  >
  </div>

  <div
    class="relative z-1 flex max-h-[calc(100dvh-40px)] w-[min(1280px,100%)] flex-col overflow-hidden rounded-2xl bg-white shadow-[0_30px_100px_rgb(0_0_0_/_40%)] max-b560:max-h-[calc(100dvh-20px)]"
    data-modal-panel
  >
    <button
      class="absolute top-3 right-3 z-2 grid size-11 cursor-pointer place-items-center rounded-full border-0 bg-bg-2 text-ink hover:bg-line"
      type="button"
      data-config-close
      aria-label={`Cerrar la ficha de la configuración ${config.name}`}
    >
      <Icon name="close" size={22} />
    </button>

    <div class="overflow-y-auto px-[30px] pt-[30px] pb-6 max-b560:px-[18px] max-b560:pt-6">
      {/* Cabecera */}
      <div class="grid grid-cols-[1fr_0.85fr] items-center gap-8 max-b900:grid-cols-1">
        <div>
          <span
            class:list={[
              'grid size-14 place-items-center rounded-xl text-white',
              accentBg,
            ]}
            aria-hidden="true"
          >
            <Icon name={config.icon} size={30} />
          </span>

          <p class="eyebrow mt-4 mb-1 text-[15px] text-muted">Configuración</p>
          <h2
            id={`config-${config.id}-title`}
            class:list={[
              'm-0 text-[clamp(34px,4.4vw,52px)] leading-[0.95] font-bold',
              accentText,
            ]}
          >
            {config.name}
          </h2>

          <p class="mt-3.5 mb-0 max-w-[520px] text-[13.5px] leading-[1.6] text-muted">
            {config.modalLead}
          </p>

          <ul class="mt-6 mb-0 grid list-none grid-cols-3 p-0">
            {
              config.stats.map((stat) => (
                <li class="border-r border-line px-3.5 text-center first:pl-0 last:border-r-0 last:pr-0">
                  <Icon name={stat.icon} size={26} class="mx-auto text-night" />
                  <b class="mt-2.5 block text-[19px] leading-[1.1] font-bold text-night">
                    {stat.value}
                  </b>
                  <small class="text-[11.5px] text-muted">{stat.label}</small>
                </li>
              ))
            }
          </ul>
        </div>

        <figure class="m-0 max-b900:order-first">
          <Image
            class="h-auto w-full"
            src={truckRender}
            alt=""
            widths={[480, 720, 960]}
            sizes="(max-width: 900px) 100vw, 40vw"
            loading="lazy"
          />
        </figure>
      </div>

      {/* Cuerpo: fotos, equipamiento y ficha tecnica */}
      <div
        class="mt-7 grid grid-cols-[1.05fr_1fr_1fr] gap-[26px] border-t border-line pt-7 max-b1100:grid-cols-1"
      >
        <div>
          <div class="grid grid-cols-[1fr_112px] gap-2.5">
            <Image
              class="aspect-[4/3] w-full rounded-xl object-cover"
              src={config.photo}
              alt={`Interior del food truck en la configuración ${config.name}`}
              widths={[420, 840]}
              sizes="(max-width: 1100px) 70vw, 26vw"
              loading="lazy"
            />
            <div class="grid gap-2.5">
              {
                config.thumbs.map((thumb) => (
                  <Image
                    class="aspect-[4/3] w-full rounded-lg object-cover"
                    src={thumb}
                    alt=""
                    widths={[224, 448]}
                    sizes="112px"
                    loading="lazy"
                  />
                ))
              }
            </div>
          </div>

          <div class="mt-4 rounded-xl border border-line bg-bg-1 p-[18px]">
            <h3 class={blockTitle}>Ideal para</h3>
            <ul class="m-0 grid list-none gap-3.5 p-0">
              {
                idealPara.map((item) => (
                  <li class="grid grid-cols-[38px_1fr] items-start gap-3">
                    <Icon name={item.icon} size={30} class="text-night" />
                    <div>
                      <b class="block text-[13px] font-bold text-night">{item.title}</b>
                      <small class="text-[11.5px] leading-[1.45] text-muted">{item.text}</small>
                    </div>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        <div>
          <h3 class={blockTitle}>Equipamiento incluido</h3>
          <ul class="m-0 grid list-none gap-2.5 p-0">
            {
              config.equipment.map((item) => (
                <li class="grid grid-cols-[78px_1fr] items-center gap-3 rounded-xl border border-line bg-white p-2.5">
                  {item.image ? (
                    <Image
                      class="aspect-[4/3] w-full rounded-lg object-cover"
                      src={item.image}
                      alt=""
                      widths={[156, 312]}
                      sizes="78px"
                      loading="lazy"
                    />
                  ) : (
                    /* Sin foto de producto todavia: recuadro con el icono. */
                    <span
                      class="grid aspect-[4/3] w-full place-items-center rounded-lg bg-bg-2 text-night"
                      aria-hidden="true"
                    >
                      <Icon name={item.icon} size={26} />
                    </span>
                  )}
                  <div>
                    <b class="block text-[13px] leading-[1.3] font-bold text-night">{item.name}</b>
                    {item.certified && (
                      <small class="block text-[11px] font-semibold text-rust">CE Certified</small>
                    )}
                    {item.spec && <small class="block text-[11.5px] text-muted">{item.spec}</small>}
                    {item.text && (
                      <small class="block text-[11.5px] leading-[1.45] text-muted">
                        {item.text}
                      </small>
                    )}
                  </div>
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <h3 class={blockTitle}>Especificaciones técnicas</h3>
          <table class="w-full border-collapse text-left text-[12px]">
            <tbody>
              {
                technicalSpecs.map((spec) => (
                  <tr class="border-b border-line last:border-b-0">
                    <th class="py-2 pr-3 font-normal text-muted">{spec.label}</th>
                    <td class="py-2 font-semibold text-night">{spec.value}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>

          <div class="mt-4 rounded-xl border border-line bg-bg-1 p-[18px]">
            <h3 class={blockTitle}>Distribución interior</h3>
            <p class="mt-0 mb-3.5 text-[12px] text-muted">
              Ver el plano detallado del interior del food truck.
            </p>
            <button
              class="button button-line button-block min-h-[46px] text-base"
              type="button"
              data-config-plan
            >
              <Icon name="plan" size={20} />
              Ver plano
            </button>
          </div>
        </div>
      </div>
    </div>

    {/* Pie con las acciones: siempre visible aunque el cuerpo tenga scroll. */}
    <div
      class="grid grid-cols-[1fr_auto_auto] items-center gap-3.5 border-t border-line bg-bg-1 px-[30px] py-[18px] max-b900:grid-cols-1 max-b560:px-[18px]"
    >
      <p
        class="m-0 grid grid-cols-[auto_1fr] items-center gap-2.5 rounded-lg bg-blue/8 px-3.5 py-2.5 text-[12px] leading-[1.45] text-muted"
      >
        <Icon name="check" size={22} class="text-blue" />
        Esta configuración incluye todo el equipamiento necesario para iniciar tu actividad con
        eficiencia y seguridad.
      </p>

      <button class="button button-line max-b900:w-full" type="button" data-config-close>
        Cerrar
      </button>
      <button
        class="button button-primary max-b900:w-full"
        type="button"
        data-config-select={config.id}
      >
        <Icon name="calendar" size={20} />
        Seleccionar esta configuración
      </button>
    </div>
  </div>
</div>
