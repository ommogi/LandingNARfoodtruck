---
/**
 * Banda partida a todo el ancho: foto real del interior a la izquierda y panel
 * oscuro a la derecha con las cinco garantias. Es la unica seccion de la pagina
 * que se sale del contenedor, igual que el hero de la home.
 */
import { Image } from 'astro:assets';
import interiorPhoto from '../../assets/gallery/hero-interior.jpg';
import Icon from '../Icon.astro';
import { interiorFeatures } from '../../data/configuraciones';
---

<section class="my-[26px] grid grid-cols-2 max-b900:grid-cols-1" aria-labelledby="interior-title">
  <figure class="m-0">
    <Image
      src={interiorPhoto}
      alt="Interior de acero inoxidable del food truck con planchas, campana extractora y lámparas de calor"
      widths={[640, 960, 1280]}
      sizes="(max-width: 900px) 100vw, 50vw"
      loading="lazy"
      class="size-full min-h-full object-cover max-b900:aspect-video max-b900:min-h-0"
    />
  </figure>

  <div
    class="bg-[linear-gradient(135deg,#16232b,#0a1c26)] px-[clamp(24px,4vw,64px)] py-11 text-white max-b560:px-[18px] max-b560:py-[30px]"
  >
    <h2 id="interior-title" class="m-0 text-[clamp(24px,2.6vw,34px)] leading-[1.05] font-bold">
      Interior profesional
      <em class="block text-rust not-italic">diseñado para rendir</em>
    </h2>

    <p class="mt-4 mb-[30px] max-w-[480px] text-[13px] leading-[1.6] text-white/78">
      Acabados premium, distribución inteligente y equipamiento profesional para que solo te
      preocupes de cocinar.
    </p>

    <ul
      class="m-0 grid list-none grid-cols-5 gap-3.5 p-0 max-b560:grid-cols-2 max-b560:gap-x-3.5 max-b560:gap-y-5"
    >
      {
        interiorFeatures.map((feature) => (
          <li class="grid justify-items-center gap-2.5 text-center">
            <Icon name={feature.icon} size={28} class="text-white" />
            <span class="text-[11.5px] leading-[1.3] font-semibold text-white/88">
              {feature.title}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
