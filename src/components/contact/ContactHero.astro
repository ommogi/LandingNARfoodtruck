---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import heroImage from '../../assets/hero-contacto.webp';

/**
 * Hero de /contacto: la promesa a la izquierda, el truck iluminado a la derecha
 * y tres garantias que responden a las dudas previas a rellenar el formulario.
 */
const guarantees = [
  { icon: 'clock', text: 'Respuesta en<br />menos de 24 h' },
  { icon: 'shield', text: 'Sin compromiso' },
  { icon: 'users', text: 'Atención<br />personalizada' },
] as const;
---

<section class="pt-[26px] pb-2.5" aria-labelledby="contact-hero-title">
  <div
    class="container grid grid-cols-[0.85fr_1.15fr] items-center gap-[clamp(28px,4.5vw,58px)] max-b900:grid-cols-1"
  >
    <div data-anim="hero">
      <p class="eyebrow flex items-center gap-2 text-night">
        <span class="text-rust" aria-hidden="true">★</span>
        Contacto
      </p>

      <h1
        class="m-0 mb-[18px] text-[clamp(40px,4.6vw,62px)] leading-[0.92] font-bold text-night"
        id="contact-hero-title"
      >
        Hablemos de <em class="block text-rust not-italic">tu evento.</em>
      </h1>

      <p class="m-0 max-w-[440px] text-[17px] text-muted">
        Configura tu food truck y te enviaremos una propuesta personalizada en menos de 24 horas.
        ¿Tienes dudas? Escríbenos y te ayudamos.
      </p>

      <div class="mt-7 flex flex-wrap gap-3.5 max-b560:grid">
        <a class="button button-primary max-b560:w-full" href="/configurador" data-track="cta_contact_hero_click">
          <Icon name="calendar" size={20} />
          Configura tu food truck
        </a>
        <a class="button button-outline max-b560:w-full" href="#formulario" data-track="cta_contact_hero_escribenos">
          <Icon name="send" size={20} />
          Escríbenos
        </a>
      </div>

      <ul class="mt-8 mb-0 flex list-none flex-wrap gap-x-7 gap-y-4 p-0">
        {
          guarantees.map((item) => (
            <li class="flex items-center gap-2.5 text-xs leading-[1.35] text-muted">
              <Icon name={item.icon} size={26} class="text-night" />
              <span set:html={item.text} />
            </li>
          ))
        }
      </ul>
    </div>

    <figure class="m-0 max-b900:order-first" data-anim="hero-media">
      <Image
        class="aspect-video w-full rounded-card object-cover shadow-card"
        src={heroImage}
        alt="Pareja paseando hacia el food truck azul NAR al atardecer"
        widths={[640, 960, 1280]}
        sizes="(max-width: 900px) 100vw, 55vw"
        loading="eager"
        fetchpriority="high"
      />
    </figure>
  </div>
</section>
