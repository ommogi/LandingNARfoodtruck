---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import mapaValencia from '../../assets/mapa-valencia.webp';
import { site } from '../../config/site';

/**
 * Franja de cierre: zona de servicio, mapa y ultimo empujon al formulario.
 *
 * El iframe de Google Maps es la unica peticion a terceros de la web, y ya no
 * se carga sola: el `src` vive en `data-src` hasta que src/scripts/consent.ts
 * confirma que el usuario acepto la categoria de mapas. Mientras tanto se ve
 * una imagen propia y difuminada del mapa de Valencia (OpenStreetMap, alojada
 * aqui: no llama a nadie) con el aviso y el boton para cargar el de Google.
 */
const coverage = [
  'Eventos privados',
  'Empresas',
  'Bodas y celebraciones',
  'Ferias y festivales',
  site.areaServed,
] as const;

/* Direccion de la nave de NAR: el mapa se centra en ella con su marcador. */
const direccionMapa = 'Calle San Vicente Mártir 420, 46017 Valencia, España';
const mapSrc = `https://maps.google.com/maps?q=${encodeURIComponent(direccionMapa)}&z=15&output=embed`;
---

<section class="section pt-0" aria-labelledby="contact-location-title">
  <div
    class="container grid grid-cols-[0.9fr_1.1fr_0.9fr] overflow-hidden rounded-card shadow-card max-b900:grid-cols-1"
    data-reveal
  >
    <div class="bg-night p-8 text-white max-b560:p-[22px]">
      <p class="m-0 mb-4 text-rust">
        <Icon name="pin" size={38} title="Ubicación" />
      </p>
      <h2 class="m-0 mb-2 text-[clamp(22px,2.6vw,28px)] font-bold" id="contact-location-title">
        Estamos en {site.locality}
      </h2>
      <p class="m-0 mb-5 text-sm text-white/70">Damos servicio a {site.areaServedLong}.</p>

      <ul class="m-0 grid list-none gap-2 p-0">
        {
          coverage.map((item) => (
            <li class="grid grid-cols-[20px_1fr] items-center gap-2.5 text-[13px] text-white/85">
              <Icon name="check-circle" size={18} class="text-rust" />
              {item}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="relative min-h-[300px] bg-bg-2" data-consent="maps">
      <iframe
        class="block size-full min-h-[300px] border-0"
        data-src={mapSrc}
        title={`Mapa de la zona de servicio: ${site.areaServed}`}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        hidden></iframe>

      {/* Se oculta en cuanto hay consentimiento. Sin JS se queda visible: es
          la version honesta, porque el mapa tampoco podria cargarse. */}
      <div
        class="relative grid size-full min-h-[300px] place-items-center overflow-hidden p-6 text-center"
        data-consent-placeholder
      >
        <Image
          src={mapaValencia}
          alt=""
          widths={[480, 900]}
          sizes="(max-width: 900px) 100vw, 40vw"
          loading="lazy"
          class="absolute inset-0 size-full scale-105 object-cover"
        />
        <span class="absolute inset-0 bg-white/35" aria-hidden="true"></span>
        <div class="relative grid max-w-[340px] justify-items-center gap-3 rounded-2xl bg-white/90 px-6 py-5 shadow-card backdrop-blur-sm">
          <span class="grid size-11 place-items-center rounded-full bg-rust text-white">
            <Icon name="pin" size={22} />
          </span>
          <p class="m-0 text-[13.5px] leading-[1.5] text-muted">
            Este mapa interactivo es de Google Maps. Al cargarlo, Google recibirá tu IP y datos del
            navegador.
          </p>
          <button class="button button-primary min-h-[44px] px-5 text-[15px]" type="button" data-consent-open>
            <Icon name="pin" size={18} />
            Cargar mapa
          </button>
        </div>
        <span class="absolute right-2 bottom-1.5 text-[10px] text-night/60">© OpenStreetMap</span>
      </div>
    </div>

    <div class="grid content-center bg-bg-1 p-8 max-b560:p-[22px]">
      <h2 class="m-0 mb-3 text-[clamp(22px,2.6vw,28px)] leading-[1.05] font-bold text-night">
        ¿Tienes una fecha en mente?
      </h2>
      <p class="m-0 mb-6 text-sm text-muted">
        Configura tu food truck y recibe una propuesta personalizada en menos de 24 horas.
      </p>
      <a
        class="button button-primary justify-self-start max-b560:w-full"
        href="/configurador"
        data-track="cta_contact_location_click"
      >
        <Icon name="calendar" size={20} />
        Configura tu food truck
      </a>
    </div>
  </div>
</section>
