---
import { eventTypes, site } from '../config/site';
import Icon from './Icon.astro';

const label = 'grid gap-1.5 mb-3.5 text-sm font-semibold';
const labelFull = `${label} mt-3.5`;
/* `is-invalid` lo pone src/scripts/landing.ts cuando el campo no valida. */
const field = [
  'w-full min-h-[46px] px-3 py-[11px] rounded-lg border border-line bg-white font-normal',
  'is-invalid:border-[#b42318] is-invalid:shadow-[0_0_0_3px_rgb(180_35_24_/_12%)]',
].join(' ');
const required = 'text-rust no-underline';
---

<div
  class="fixed inset-0 z-[1000] grid place-items-center p-5 print:hidden"
  hidden
  data-form-modal
  role="dialog"
  aria-modal="true"
  aria-labelledby="form-title"
>
  <div
    class="absolute inset-0 bg-black/76 backdrop-blur-[5px]"
    data-form-close
    data-modal-backdrop
  >
  </div>

  <div
    class="relative z-1 max-h-[calc(100dvh-40px)] w-[min(760px,100%)] overflow-auto rounded-2xl bg-white p-[34px] shadow-[0_30px_100px_rgb(0_0_0_/_40%)] max-b560:px-[18px] max-b560:py-[26px]"
    data-modal-panel
  >
    <button
      class="absolute top-3 right-3 grid size-11 cursor-pointer place-items-center rounded-full border-0 bg-bg-2 text-ink hover:bg-line"
      type="button"
      data-form-close
      aria-label="Cerrar formulario"
    >
      <Icon name="close" size={22} />
    </button>

    <h2 id="form-title" class="m-0 mb-1.5 pr-[46px] text-[clamp(28px,4vw,38px)] font-bold">
      Solicitar presupuesto
    </h2>
    <p class="m-0 mb-[22px] text-sm text-muted">
      Cuéntanos lo esencial de tu evento y te enviamos una propuesta personalizada en menos de 24 horas.
    </p>

    <form data-lead-form novalidate>
      <div class="grid grid-cols-2 gap-4 max-b560:grid-cols-1">
        <label class={label}>
          <span>Nombre <abbr class={required} title="obligatorio">*</abbr></span>
          <input class={field} name="name" autocomplete="name" required minlength="2" maxlength="80" />
        </label>

        <label class={label}>
          <span>Email <abbr class={required} title="obligatorio">*</abbr></span>
          <input class={field} type="email" name="email" autocomplete="email" required />
        </label>

        <label class={label}>
          <span>Teléfono <abbr class={required} title="obligatorio">*</abbr></span>
          <input
            class={field}
            type="tel"
            name="phone"
            autocomplete="tel"
            required
            minlength="6"
            maxlength="40"
          />
        </label>

        <label class={label}>
          <span>Tipo de evento <abbr class={required} title="obligatorio">*</abbr></span>
          <select class={field} name="eventType" required>
            <option value="">Selecciona</option>
            {eventTypes.map((type) => <option>{type}</option>)}
          </select>
        </label>

        <label class={label}>
          <span>Fecha</span>
          <input class={field} type="date" name="date" />
          <small class="text-xs font-normal text-muted">
            Si aún no la tienes definida, déjala en blanco.
          </small>
        </label>

        <label class={label}>
          <span>Número de invitados</span>
          <input class={field} type="number" name="guests" min="1" max="5000" inputmode="numeric" />
        </label>
      </div>

      <label class={labelFull}>
        <span>Ubicación</span>
        <input
          class={field}
          name="location"
          autocomplete="address-level2"
          placeholder={`${site.locality} o municipio`}
          maxlength="160"
        />
      </label>

      <label class={labelFull}>
        <span>Cuéntanos tu idea</span>
        <textarea class={`${field} min-h-[130px] resize-y`} name="message" maxlength="1500"></textarea>
      </label>

      {/* Honeypot anti-spam: oculto visualmente y fuera del orden de tabulación. */}
      <label class={`${label} absolute! -left-[9999px]`} aria-hidden="true">
        Web
        <input name="website" tabindex="-1" autocomplete="off" />
      </label>

      <label class="mb-3.5 grid grid-cols-[auto_1fr] items-start gap-2.5 text-sm font-normal">
        <input class="mt-[3px] size-5 min-h-5" type="checkbox" name="consent" required />
        <span>
          He leído y acepto la <a class="text-rust underline" href="/privacidad" target="_blank" rel="noopener">política de privacidad</a>.
        </span>
      </label>

      <button class="button button-primary button-block" type="submit">Enviar solicitud</button>
      <p
        class="mt-3 mb-0 min-h-6 text-sm font-semibold is-error:text-[#b42318] is-success:text-[#17663a]"
        data-form-status
        role="status"
        aria-live="polite"
      >
      </p>
    </form>
  </div>
</div>
