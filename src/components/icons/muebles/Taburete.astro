---
/** Taburete alto. Mismo formato que Lucide (24x24, trazo 2) para convivir en icons.ts. */
interface Props {
  size?: number;
  fill?: string;
  class?: string;
  [atributo: string]: unknown;
}
const { size = 24, fill = 'none', class: className, ...resto } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={fill}
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  {...resto}
>
  <path d="M7 5h10" /><path d="m8 5-2 15" /><path d="m16 5 2 15" /><path d="M7.4 14h9.2" />
</svg>
