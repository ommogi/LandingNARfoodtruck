---
/**
 * Panel oscuro con los argumentos de venta y la tarjeta de video.
 * Reutiliza el VideoModal global (patron data-video-open de landing.ts).
 */
import { Image } from 'astro:assets';
import poster from '../../assets/video-poster.png';
import Icon from '../Icon.astro';

const reasons = [
  {
    icon: 'gem',
    title: 'Diseño exclusivo',
    text: 'Imagen moderna que aporta valor a tu evento.',
  },
  {
    icon: 'chef',
    title: 'Cocina profesional',
    text: 'Equipamiento de alta gama para resultados excelentes.',
  },
  {
    icon: 'bolt',
    title: 'Autonomía total',
    text: 'No requiere conexiones externas ni instalaciones.',
  },
  {
    icon: 'users',
    title: 'Alta capacidad',
    text: 'Hasta 150 personas/hora sin comprometer la calidad.',
  },
] as const;

const reason = [
  'border-r border-white/16 px-4 text-center',
  'first:pl-0 last:border-r-0 last:pr-0',
  'max-b980:even:border-r-0 max-b980:even:pr-0 max-b980:odd:pl-0',
  'max-b560:border-r-0 max-b560:px-0',
].join(' ');
---

<section class="section" aria-labelledby="why-title">
  <div class="container">
    <div
      class="grid grid-cols-[1.15fr_0.85fr] items-center gap-[34px] rounded-card bg-[linear-gradient(135deg,#16232b,#0a1c26)] p-[30px] text-white max-b980:grid-cols-1 max-b560:px-[18px] max-b560:py-6"
      data-reveal
    >
      <div>
        <h2
          id="why-title"
          class="m-0 mb-[26px] text-[clamp(24px,2.6vw,34px)] leading-[1.05] font-bold"
        >
          ¿Por qué elegir nuestro food truck?
          <span class="ml-1.5 inline-block align-[2px] text-rust" aria-hidden="true">
            <Icon name="star" size={16} fill="currentColor" />
          </span>
        </h2>

        <ul
          class="m-0 grid list-none grid-cols-4 p-0 max-b980:grid-cols-2 max-b980:gap-y-6 max-b560:grid-cols-1"
        >
          {
            reasons.map((item) => (
              <li class={reason}>
                <Icon name={item.icon} size={32} class="mx-auto text-rust" />
                <h3 class="mt-3 mb-2 text-[13.5px] leading-[1.2] font-bold">{item.title}</h3>
                <p class="m-0 text-[11.5px] leading-[1.5] text-white/78">{item.text}</p>
              </li>
            ))
          }
        </ul>
      </div>

      {/* Mismo patron que la tarjeta de video de la home. */}
      <button
        class="group relative cursor-pointer overflow-hidden rounded-[14px] border-0 bg-black p-0 print:hidden"
        type="button"
        data-video-open
        aria-label="Ver el truck en acción"
      >
        <Image
          src={poster}
          alt="Food truck NAR iluminado durante un evento nocturno"
          widths={[480, 720, 960]}
          sizes="(max-width: 980px) 100vw, 40vw"
          loading="lazy"
          class="aspect-16/10 w-full object-cover transition-transform duration-400 ease-out group-hover:scale-[1.025]"
        />
        <span
          class="absolute top-1/2 left-1/2 grid size-[72px] -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full bg-white text-night"
          aria-hidden="true"
        >
          <Icon name="play" size={30} />
        </span>
        <span
          class="absolute bottom-[18px] left-5 grid gap-0.5 text-left text-white [text-shadow:0_2px_12px_rgb(0_0_0_/_65%)]"
        >
          <strong class="font-display text-[19px] uppercase">Ver el truck en acción</strong>
          <small class="text-xs">Descubre cada detalle en este vídeo de 45 segundos.</small>
        </span>
      </button>
    </div>
  </div>
</section>
