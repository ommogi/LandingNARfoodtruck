---
import Icon from '../Icon.astro';
import SectionHeading from '../SectionHeading.astro';

const features = [
  {
    icons: ['sparkles'],
    title: 'Un espacio, muchas posibilidades',
    text: 'Café, burgers, cocktails, waffles y mucho más.',
  },
  {
    icons: ['wrench'],
    title: 'Montaje rápido',
    text: 'Listo para servir en menos de 60 minutos.',
  },
  {
    icons: ['pin'],
    title: 'Máxima movilidad',
    text: 'Accedemos prácticamente a cualquier ubicación.',
  },
  {
    icons: ['shield'],
    title: 'Cumple normativa sanitaria',
    text: 'Cumplimos con todas las normativas de higiene y seguridad.',
  },
] as const;

const feature = [
  'border-r border-line px-[22px] py-1 text-center last:border-r-0',
  'max-b820:even:border-r-0',
  'max-b560:border-r-0',
].join(' ');
---

<section class="section" aria-labelledby="ready-title">
  <div class="container">
    <div
      class="rounded-card border border-[rgb(56_40_30_/_8%)] bg-white/96 px-[30px] pt-[34px] pb-[38px] shadow-card max-b560:px-[18px] max-b560:pt-[26px] max-b560:pb-[30px]"
      data-reveal
    >
      <SectionHeading title="Listo para cualquier lugar" id="ready-title" />
      <p class="mx-auto mt-[-20px] mb-8 max-w-[620px] text-center text-[13.5px] text-muted">
        Gracias a su diseño compacto y versátil, podemos montar en prácticamente cualquier espacio.
      </p>

      <ul
        class="m-0 grid list-none grid-cols-4 p-0 max-b820:grid-cols-2 max-b820:gap-y-[26px] max-b560:grid-cols-1"
      >
        {
          features.map((item) => (
            <li class={feature}>
              <span class="flex justify-center gap-1.5 text-night">
                {item.icons.map((icon) => (
                  <Icon name={icon} size={30} />
                ))}
              </span>
              <h3 class="mt-3.5 mb-2 text-[15px] leading-[1.2] font-bold">{item.title}</h3>
              <p class="m-0 text-xs leading-[1.5] text-muted">{item.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
