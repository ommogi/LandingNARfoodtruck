---
/**
 * Descarga de documentacion tecnica. Los PDF viven en public/docs/ (la
 * configuracion base se comprimio de 11,6 MB a ~450 KB optimizando sus imagenes
 * para pantalla). `ready: false` deja el enlace inerte para no ofrecer un 404.
 *
 * La distribucion interior no es un PDF: es el plano del fabricante, el mismo
 * que muestra /configuraciones, y se abre a tamano completo en otra pestana.
 */
import { getImage } from 'astro:assets';
import Icon from '../Icon.astro';
import plano from '../../assets/plano-distribucion.webp';

const planoGrande = await getImage({ src: plano, width: 1600, format: 'webp' });

const docs = [
  {
    title: 'Ficha técnica del vehículo',
    file: '/docs/nar-ficha-tecnica-vehiculo.pdf',
    ready: true,
  },
  {
    title: 'Ficha técnica del equipamiento',
    file: '/docs/nar-ficha-tecnica-equipamiento.pdf',
    ready: true,
  },
  {
    title: 'Configuración base',
    file: '/docs/nar-configuracion-base.pdf',
    ready: true,
  },
  {
    title: 'Distribución interior',
    file: planoGrande.src,
    ready: true,
    plano: true,
  },
];
---

<section class="section" aria-labelledby="docs-title">
  <div class="container">
    <div
      class="grid grid-cols-[0.85fr_2.15fr] items-center gap-[34px] rounded-card border border-[rgb(56_40_30_/_8%)] bg-white/96 p-[30px] shadow-card max-b980:grid-cols-1 max-b980:gap-[26px] max-b560:px-[18px] max-b560:py-6"
      data-reveal
    >
      <div>
        <h2 id="docs-title" class="m-0 mb-2.5 text-[clamp(21px,2.1vw,26px)] leading-[1.1] font-bold">
          Descarga documentación
          <span class="ml-[5px] inline-block align-[2px] text-rust" aria-hidden="true">
            <Icon name="star" size={14} fill="currentColor" />
          </span>
        </h2>
        <p class="m-0 text-[12.5px] leading-[1.6] text-muted">
          Consulta y descarga toda la información técnica de nuestro food truck. Ideal para
          organizadores de eventos y profesionales.
        </p>
      </div>

      <ul class="m-0 grid list-none grid-cols-4 gap-6 p-0 max-b1100:grid-cols-2 max-b560:grid-cols-1">
        {
          docs.map((doc) => (
            <li class="grid grid-cols-[34px_1fr] grid-rows-[auto_auto] items-center gap-x-2.5 gap-y-1.5">
              <span class="text-night" aria-hidden="true">
                <Icon name={'plano' in doc ? 'plan' : 'doc'} size={26} />
              </span>
              <h3 class="m-0 text-[13.5px] leading-[1.25] font-bold">{doc.title}</h3>
              <a
                class:list={[
                  'button button-outline col-span-2 mt-2 min-h-11 text-[15px] print:hidden',
                  /* Placeholder mientras el PDF no existe: visible pero no activable. */
                  !doc.ready && 'pointer-events-none opacity-55',
                ]}
                href={doc.file}
                {...('plano' in doc
                  ? { target: '_blank', rel: 'noopener' }
                  : { download: true })}
                aria-disabled={doc.ready ? undefined : 'true'}
                tabindex={doc.ready ? undefined : -1}
                data-track="doc_download"
              >
                <Icon name={'plano' in doc ? 'search' : 'download'} size={18} />
                {'plano' in doc ? 'Ver plano' : 'Descargar PDF'}
              </a>
              {!doc.ready && <span class="sr-only">Documento disponible próximamente.</span>}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
