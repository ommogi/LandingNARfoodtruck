---
import BaseLayout from '../layouts/BaseLayout.astro';
import GalleryHero from '../components/gallery/GalleryHero.astro';
import GalleryGrid from '../components/gallery/GalleryGrid.astro';
import BookingCta from '../components/gallery/BookingCta.astro';
import Lightbox from '../components/gallery/Lightbox.astro';
---

<BaseLayout
  title="Galería | Alquiler de food truck NAR"
  description="Alquila un food truck equipado para bodas, eventos, ferias y acciones de marca. Consulta fechas y configuraciones disponibles."
  path="/galeria"
  leadSource="landing-galeria"
>
  <GalleryHero />
  <GalleryGrid />
  <BookingCta />

  <Fragment slot="overlays">
    <Lightbox />
  </Fragment>
</BaseLayout>

<script>
  import '../scripts/landing';
  import '../scripts/gallery';
</script>
