---
import BaseLayout from '../layouts/BaseLayout.astro';
import ConfigHero from '../components/config/ConfigHero.astro';
import ConfigInterior from '../components/config/ConfigInterior.astro';
import ConfigCards from '../components/config/ConfigCards.astro';
import ConfigLayout from '../components/config/ConfigLayout.astro';
import ConfigPerks from '../components/config/ConfigPerks.astro';
import QuoteFormModal from '../components/QuoteFormModal.astro';
import BookingModal from '../components/booking/BookingModal.astro';
import { serviceOffersNode } from '../lib/schema';

/* Las cuatro ofertas salen de src/data/configuraciones.ts, los mismos precios
   que pintan las tarjetas de esta pagina. */
---

<BaseLayout
  title="Configuraciones del food truck: Base, Compact, Profesional y Max | NAR"
  description="Cuatro configuraciones de equipamiento desde 890 € al día. Compara equipamiento, medidas interiores y especificaciones técnicas de nuestro food truck."
  path="/configuraciones"
  leadSource="landing-configuraciones"
  schemas={[serviceOffersNode()]}
  breadcrumbs={[{ name: 'Configuraciones', path: '/configuraciones' }]}
>
  <ConfigHero />
  <ConfigInterior />
  <ConfigCards />
  <ConfigLayout />
  <ConfigPerks />

  <Fragment slot="overlays">
    <QuoteFormModal />
    <BookingModal />
  </Fragment>
</BaseLayout>

<script>
  import '../scripts/landing';
  import '../scripts/booking';
  import '../scripts/configuraciones';
</script>
