---
import BaseLayout from '../layouts/BaseLayout.astro';
import ConfigHero from '../components/config/ConfigHero.astro';
import ConfigInterior from '../components/config/ConfigInterior.astro';
import ConfigCta from '../components/config/ConfigCta.astro';
import ConfigLayout from '../components/config/ConfigLayout.astro';
import ConfigPerks from '../components/config/ConfigPerks.astro';
import { serviceOffersNode } from '../lib/schema';

/* La oferta del JSON-LD es el FOODD Rental Base, el mismo "Desde" que pinta
   ConfigCta. El equipamiento ya no va por paquetes: se elige en /configurador. */
---

<BaseLayout
  title="Configura tu food truck a medida | NAR"
  description="Configura tu food truck a medida: equipamiento, cocinero, ambientación y branding. Desde 450 € + IVA al día. Consulta medidas interiores y especificaciones técnicas."
  path="/configuraciones"
  leadSource="landing-configuraciones"
  schemas={[serviceOffersNode()]}
>
  <ConfigHero />
  <ConfigInterior />
  <ConfigCta />
  <ConfigLayout />
  <ConfigPerks />

</BaseLayout>

<script>
  import '../scripts/landing';
</script>
