---
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutHero from '../components/about/AboutHero.astro';
import AboutHistory from '../components/about/AboutHistory.astro';
import AboutStats from '../components/about/AboutStats.astro';
import AboutServices from '../components/about/AboutServices.astro';
import AboutValues from '../components/about/AboutValues.astro';
import TruckFinalCta from '../components/truck/TruckFinalCta.astro';
import QuoteFormModal from '../components/QuoteFormModal.astro';
import BookingModal from '../components/booking/BookingModal.astro';
---

<BaseLayout
  title="Sobre nosotros: pasión por los grandes eventos | NAR"
  description="NAR nació en 1981 y hoy es una empresa familiar especializada en el alquiler de food trucks para eventos, con 40 años de experiencia y más de 25.000 clientes satisfechos."
  path="/nosotros"
  leadSource="landing-nosotros"
>
  <AboutHero />
  <AboutHistory />
  <AboutStats />
  <AboutServices />
  <AboutValues />
  <TruckFinalCta
    title="¿Tienes un evento en mente?"
    claim="Cuéntanos tu idea y te ayudaremos a hacerlo realidad."
    cta="Consultar disponibilidad"
    track="cta_about_final"
  />

  <Fragment slot="overlays">
    <QuoteFormModal />
    <BookingModal />
  </Fragment>
</BaseLayout>

<script>
  import '../scripts/landing';
  import '../scripts/booking';
</script>
