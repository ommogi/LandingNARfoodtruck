---
/**
 * Panel de disponibilidad. Aqui el cliente marca que dias estan ocupados o casi
 * cerrados, bloquea periodos enteros y ajusta la antelacion minima.
 *
 * Los datos se cargan en servidor para que el calendario aparezca ya pintado: el
 * middleware ya ha resuelto la sesion, asi que no hay nada que esperar.
 *
 * La rejilla la rellena src/scripts/admin.ts, igual que en el calendario del
 * visitante: un mes renderizado en el build envejeceria con el despliegue.
 */
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import { DIAS, LIMITES } from '../../data/disponibilidad';
import { getDisponibilidad } from '../../lib/disponibilidad-server';

export const prerender = false;

const dispo = await getDisponibilidad(Astro.locals.supabase);

const card = 'rounded-card border border-line bg-white p-5 shadow-card';
const navButton =
  'grid size-11 place-items-center rounded-lg border border-line bg-white text-ink disabled:cursor-not-allowed disabled:opacity-40 not-disabled:cursor-pointer not-disabled:hover:border-night';
const input =
  'min-h-11 w-full rounded-lg border border-line bg-white px-3 text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue';
const label = 'text-[13px] font-semibold text-ink';

const leyenda = [
  { color: 'bg-white border border-line', text: 'Libre' },
  { color: 'bg-rust/15 border border-rust/40', text: 'Poca disponibilidad' },
  { color: 'bg-night', text: 'Ocupado' },
];
---

<AdminLayout title="Disponibilidad" email={Astro.locals.userEmail}>
  <div class="grid gap-6">
    <p class="m-0 text-[14px] text-muted">
      Haz clic en un día para cambiar su estado: <strong class="text-ink">libre</strong> →
      <strong class="text-ink">ocupado</strong> → <strong class="text-ink">poca disponibilidad</strong>
      → libre otra vez. Los cambios no se aplican hasta que pulses «Guardar cambios».
    </p>

    <!-- Calendario -->
    <section class={card}>
      <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
        <h2 class="m-0 font-display text-[22px] leading-none text-blue">Calendario</h2>

        <div class="flex items-center gap-2">
          <button class={navButton} type="button" data-cal-prev aria-label="Mes anterior">
            <Icon name="chevron-left" size={20} />
          </button>
          <select
            class="min-h-11 min-w-[180px] cursor-pointer rounded-lg border border-line bg-white px-3 font-semibold"
            data-cal-month
            aria-label="Mes del calendario"
          >
          </select>
          <button class={navButton} type="button" data-cal-next aria-label="Mes siguiente">
            <Icon name="chevron-right" size={20} />
          </button>
        </div>
      </div>

      <div class="overflow-hidden rounded-xl border border-line">
        <div
          class="grid grid-cols-7 border-b border-line bg-bg-2 text-center text-[11px] font-bold tracking-[0.04em] text-muted uppercase"
        >
          {DIAS.map((dia) => <span class="py-2.5">{dia}</span>)}
        </div>

        {/* Lo rellena renderMonth() en src/scripts/admin.ts. */}
        <div class="grid grid-cols-7" data-cal-grid role="group" aria-label="Días del mes"></div>
      </div>

      <p
        class="m-0 mt-4 rounded-lg border border-blue/25 bg-blue/6 px-4 py-3 text-[13px] text-blue"
        data-aviso-plazo
        role="status"
        hidden
      >
      </p>

      <ul class="m-0 mt-4 flex list-none flex-wrap gap-x-6 gap-y-2 p-0 text-[12.5px] text-muted">
        {
          leyenda.map((item) => (
            <li class="flex items-center gap-2">
              <span class:list={['size-3 rounded-full', item.color]} aria-hidden="true" />
              {item.text}
            </li>
          ))
        }
        <li class="flex items-center gap-2">
          <span
            class="size-3 rounded-full"
            style="background-image: repeating-linear-gradient(-45deg, var(--color-bg-2) 0 2px, var(--color-muted) 2px 3px)"
            aria-hidden="true"></span>
          Rayado: fuera de plazo, no se nota en la web
        </li>
      </ul>
    </section>

    <div class="grid gap-6 b820:grid-cols-2">
      <!-- Rangos -->
      <section class={card}>
        <h2 class="m-0 mb-1 font-display text-[22px] leading-none text-blue">Bloquear un periodo</h2>
        <p class="mt-1 mb-4 text-[13px] text-muted">
          Para vacaciones o taller. Marca todos los días del rango de una vez; luego puedes
          ajustar días sueltos en el calendario.
        </p>

        <div class="grid gap-3">
          <div class="grid gap-3 b560:grid-cols-2">
            <div class="grid gap-1.5">
              <label class={label} for="rango-desde">Desde</label>
              <input class={input} id="rango-desde" type="date" data-rango-desde />
            </div>
            <div class="grid gap-1.5">
              <label class={label} for="rango-hasta">Hasta</label>
              <input class={input} id="rango-hasta" type="date" data-rango-hasta />
            </div>
          </div>

          <div class="grid gap-1.5">
            <label class={label} for="rango-estado">Marcar como</label>
            <select class={input} id="rango-estado" data-rango-estado>
              <option value="ocupado">Ocupado</option>
              <option value="poca">Poca disponibilidad</option>
              <option value="libre">Libre (desbloquear)</option>
            </select>
          </div>

          <button
            class="min-h-11 cursor-pointer rounded-lg border border-night bg-white px-4 font-semibold text-night hover:bg-bg-2"
            type="button"
            data-rango-aplicar
          >
            Aplicar al calendario
          </button>

          <p class="m-0 min-h-5 text-[13px] text-muted is-error:text-rust" data-rango-status role="status"></p>
        </div>
      </section>

      <!-- Ajustes -->
      <section class={card}>
        <h2 class="m-0 mb-1 font-display text-[22px] leading-none text-blue">Ajustes</h2>
        <p class="mt-1 mb-4 text-[13px] text-muted">
          Reglas que aplican a todo el calendario del asistente de reserva.
        </p>

        <div class="grid gap-3">
          <div class="grid gap-1.5">
            <label class={label} for="min-dias">Antelación mínima (días)</label>
            <input
              class={input}
              id="min-dias"
              type="number"
              min={LIMITES.minDiasAntelacion.min}
              max={LIMITES.minDiasAntelacion.max}
              step="1"
              value={dispo.minDiasAntelacion}
              data-min-dias
            />
            <p class="m-0 text-[12.5px] text-muted">
              Nadie podrá elegir una fecha que esté a menos días de hoy.
            </p>
          </div>

          <div class="grid gap-1.5">
            <label class={label} for="meses-visibles">Meses visibles</label>
            <input
              class={input}
              id="meses-visibles"
              type="number"
              min={LIMITES.mesesVisibles.min}
              max={LIMITES.mesesVisibles.max}
              step="1"
              value={dispo.mesesVisibles}
              data-meses-visibles
            />
            <p class="m-0 text-[12.5px] text-muted">
              Hasta cuántos meses hacia delante se puede navegar en el calendario.
            </p>
          </div>
        </div>
      </section>
    </div>

    <!-- Barra de guardado -->
    <div
      class="sticky bottom-4 flex flex-wrap items-center justify-between gap-3 rounded-card border border-line bg-white p-4 shadow-card"
    >
      <p class="m-0 text-[13px] text-muted is-error:text-rust is-success:text-blue" data-save-status role="status">
        Sin cambios pendientes.
      </p>

      <div class="flex gap-2">
        <button
          class="min-h-11 rounded-lg border border-line bg-white px-4 font-semibold text-ink disabled:cursor-not-allowed disabled:opacity-40 not-disabled:cursor-pointer not-disabled:hover:border-night"
          type="button"
          data-descartar
          disabled
        >
          Descartar
        </button>
        <button
          class="min-h-11 rounded-lg bg-rust px-5 font-semibold text-white disabled:cursor-not-allowed disabled:opacity-40 not-disabled:cursor-pointer not-disabled:hover:bg-rust-dark"
          type="button"
          data-guardar
          disabled
        >
          Guardar cambios
        </button>
      </div>
    </div>
  </div>

  {/* Estado inicial para src/scripts/admin.ts, sin otra peticion al arrancar. */}
  <script type="application/json" data-dispo-inicial set:html={JSON.stringify(dispo)} is:inline />

  <script>
    import '../../scripts/admin';
  </script>
</AdminLayout>

<style>
  /*
   * El calendario del visitante deshabilita los dias ocupados, asi que le vale
   * el estilo de :disabled. Aqui hay que poder clicarlos para liberarlos, asi
   * que los estados llevan su propio color.
   */
  :global(.cal-day.is-admin-ocupado),
  :global(.cal-day.is-admin-ocupado:hover) {
    color: #fff;
    background: var(--color-night);
  }

  :global(.cal-day.is-admin-poca),
  :global(.cal-day.is-admin-poca:hover) {
    color: var(--color-rust);
    background: rgb(166 57 33 / 15%);
    box-shadow: inset 0 0 0 1px rgb(166 57 33 / 40%);
  }

  /*
   * Fuera de plazo: en la web estos dias ya salen bloqueados por la antelacion
   * minima, pase lo que pase aqui. Se rayan para que se vea que marcarlos no
   * cambia nada de lo que ve el visitante, sin impedir marcarlos: el cliente
   * puede bajar la antelacion mas adelante y entonces si cuentan.
   */
  :global(.cal-day.is-fuera-plazo) {
    background-image: repeating-linear-gradient(
      -45deg,
      transparent 0 5px,
      rgb(93 93 93 / 22%) 5px 7px
    );
    opacity: 0.75;
  }

  :global(.cal-day.is-fuera-plazo:not(.is-admin-ocupado):not(.is-admin-poca)) {
    color: var(--color-muted);
  }

  /* Cambiado y sin guardar: un punto en la esquina, visible sobre cualquier fondo. */
  :global(.cal-day.is-sucio) {
    position: relative;
  }

  :global(.cal-day.is-sucio::after) {
    content: '';
    position: absolute;
    top: 6px;
    right: 6px;
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--color-blue-light);
  }
</style>
